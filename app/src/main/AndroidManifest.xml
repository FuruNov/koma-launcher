<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 全パッケージの閲覧権限は使わず、ランチャーに出るアプリだけを見えるようにする -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- 通知センターを開くため（StatusBarManager の非公開のメソッド） -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- 音楽プレイヤーのコマの「音に合わせて動かす」（Visualizer で音の周波数を受け取る。録音はしない） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".KomaApplication"
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/Theme.Koma">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|uiMode|screenSize|smallestScreenSize|screenLayout|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:taskAffinity="dev.furunov.komalauncher.editor" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:taskAffinity="dev.furunov.komalauncher.settings" />
    </application>
</manifest>
